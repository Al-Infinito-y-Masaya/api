api.mangroove.earth {
	encode zstd gzip

	@retirados path /auth/email-* /auth/register* /auth/two-factor* /auth/mobile/two-factor* /auth/web/two-factor* /media /media/*
	respond @retirados 404

	@operacion path /operacion/* /auth/user/* /auth/group/* /auth/permission/*
	respond @operacion 404

	header -Server

	reverse_proxy 127.0.0.1:8080 {
		health_uri /health/
		health_interval 30s
		health_timeout 5s
	}

	log {
		output file /var/log/caddy/api.mangroove.earth.log {
			roll_size 50MiB
			roll_keep 5
		}
		format json
	}
}
